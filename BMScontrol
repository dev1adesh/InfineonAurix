static uint32_t bmsControl_calculateSOC(uint16_t voltage)
{
	uint32_t tempSOC = ((voltage - 2700)*1e6)/(TLE9012_CELL_FLOAT-2700);
	if (tempSOC > 1000000)
	{
		tempSOC = 1000000;
	}
	return tempSOC;
}
