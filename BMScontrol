void bmsControl_clearMetrics(void)
{
	for (uint8_t i=0;i< TLE9012_NUMBER_NODES;i++)
	{
		cellInfo.batV[i] = 0;
		cellInfo.cellBalancingPosition[i] = 0;
		cellInfo.cellBalancingRequired[i] = 0;
		for (uint8_t cell = 0; cell <TLE9012_NUMBER_OF_CELLS; cell++)
		{
			cellInfo.cellV[i][cell] = 0;
			cellInfo.soc[i][cell] = 0;
		}
		for (uint8_t therm = 0; therm < TLE9012_NUMBER_EXT_THERM; therm++)
		{
			cellInfo.extTemp[i][therm] = 0;
		}
		cellInfo.intTemp[i] = 0;
		cellInfo.highestCell[i] = 0;
		cellInfo.lowestCell[i] = 0;
		cellInfo.numCellsRequireBalancing[i] = 0;
	}
}
