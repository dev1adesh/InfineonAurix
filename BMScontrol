/**
 ******************************************************************************
 *
 * @author 	RL
 * @date   	Jan2021
 * @brief	Function: bmsControl_TLE9012_Initialization()\n
 * 			This function performs the following functions\n
 * 			1.) Enumerates the 9012\n
 *
 * @retval	True on success
 * @retval  False on failure
 *****************************************************************************/
static boolean bmsControl_TLE9012_Initialization(void)
{
	xTaskDelay(100);
	uint8_t errormsg;
	boolean retVal = TRUE;
	/*
	 * 1. Enumerate
	 * 2. Initialize Config registers
	 * 2. Config Thresholds
	 * 3. Flag Initialization done
	 */

	//1. Enumerate
	tle9012Info.ntwkConfig = TLE9012_NTWK_CONFIG;
	tle9012Info.wdgEnable = TLE9012_KEEP_ALIVE;
	tle9012Info.numExtThermistors = TLE9012_NUMBER_EXT_THERM;
	tle9012Info.balancingEnabled = BALANCING_ON;
	tle9012Info.numNodesDetected = tle9012_enumerateNetwork(TLE9012_NTWK_CONFIG, TLE9012_ENABLE_ADCS, 0, TLE9012_KEEP_ALIVE, bmsControl.nodesInSystem, &errormsg);

	if (tle9012Info.numNodesDetected == bmsControl.nodesInSystem)
	{
		tle9012Info.isNumerated = true;
	}
	else
	{
		tle9012Info.isNumerated = false;
		retVal = false;
	}

	return retVal;
}
/**
 ******************************************************************************
 *
 * @author 	RL
 * @date   	Jan2021
 * @brief	Function: bmsControl_getBatteryMetrics()\n
 * 		This function retrieves the Battery Pack metrics from the Fuel Gauge and stores it
 * 		into the packInfo structure\n
 * 		It will also set or clear the charge / discharge flags in BMS_FLAGS_t
 *
 * @retval	None.
 *****************************************************************************/
static void bmsControl_getBatteryMetrics(void)
{
	TLE9012_GPIO_Register_t	configGPIO;
	uint8_t errormsg;




	if (TRUE == bmsControl.flowControl.tle9012_Control)
	{
		switch (bmsControl.flowControl.fuelGauge_Control)
		{
			case FUEL_GAUGE_NONE:
			{
				break;
			}
			case FUEL_GAUGE_PSOC:
			{
				if (true == tle9012Info.isInitialized)
				{
					if (TRUE == flagRecvdPsocCurrent)
					{
						packInfo.packCurrent = psoc_Current;
						packInfo.packVoltage = cellInfo.batV[0];
						flagRecvdPsocCurrent = FALSE;
					}
				}

				break;
			}
			default:
			{
				break;
			}
		}

		configGPIO.U16 = tle9012Info.registers[0].GPIO_Reg.U16;

		if (packInfo.packCurrent > ICHARGE_MIN)
		{
			if(bmsControl.charging == 0)
			{
				configGPIO.B.PWM_PWM0 = 1;
				configGPIO.B.PWM_PWM1 = 0;
				tle9012_WrReg(TLE9012_NTWK_CONFIG, TLE9012_BROADCAST_DEVICE, TLE9012_REG_GPIO,configGPIO.U16,&errormsg);

			}
			bmsControl.charging = 1;
			bmsControl.discharging = 0;

		}
		else if(packInfo.packCurrent < IDISCHARGE_MIN)
		{
			if(bmsControl.discharging == 0)
			{
				configGPIO.B.PWM_PWM0 = 0;
				configGPIO.B.PWM_PWM1 = 1;


				tle9012_WrReg(TLE9012_NTWK_CONFIG, TLE9012_BROADCAST_DEVICE, TLE9012_REG_GPIO,configGPIO.U16,&errormsg);
			}
			bmsControl.discharging = 1;
			bmsControl.charging = 0;

		}
		else
		{
			if(bmsControl.charging == 1 || bmsControl.discharging ==1)
			{
				configGPIO.B.PWM_PWM0 = 0;
				configGPIO.B.PWM_PWM1 = 0;

				tle9012_WrReg(TLE9012_NTWK_CONFIG, TLE9012_BROADCAST_DEVICE, TLE9012_REG_GPIO,configGPIO.U16,&errormsg);
			}
			bmsControl.charging = 0;
			bmsControl.discharging = 0;
		}
	}
}

/**
 ******************************************************************************
 *
 * @author 	RL
 * @date   	Jan2021
 * @brief	Function: bmsControl_getCellMetrics()\n
 * 		This function retrieves the Cell metrics from the TLE9012 and stores it
 * 		into the cellInfo structure -> CELL_INFO_t
 *
 *
 * @retval	None.
 *****************************************************************************/
static void bmsControl_getCellMetrics(void)
{

	if (TRUE == bmsControl.flowControl.tle9012_Control)
	{
		uint8_t errormsg;
		uint8_t readresult[10];

		if (tle9012Info.isInitialized)
		{
			cellInfo.gettingMeasurement = 1;
			//trigger measurement
			tle9012_WrReg(TLE9012_NTWK_CONFIG, TLE9012_BROADCAST_DEVICE, TLE9012_REG_MEAS_CTRL, TLE9012_TRIG_MEAS, &errormsg );

			xTaskDelay(50);

			for (uint8_t i=0;i< tle9012Info.numNodesDetected;i++)
			{
				tle9012Info.registers[i].MEAS_CTRL_Reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, 0x01, TLE9012_REG_MEAS_CTRL, readresult);
				while ((tle9012Info.registers[i].MEAS_CTRL_Reg.U16 & 0x8840) != 0x0000 ) // Is a measurement in process
				{
					delayMillseconds(1);
					tle9012Info.registers[i].MEAS_CTRL_Reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, 0x01, TLE9012_REG_MEAS_CTRL, readresult);
				}
				//Pack Voltage
				tle9012Info.registers[i].BVM_Reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i+1, TLE9012_REG_BVM, readresult);
				cellInfo.batV[i] = tle9012Info.registers[i].BVM_Reg.U16 *60000/65536;

                tle9012Info.registers[i].GPIO_Reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i + 1, TLE9012_REG_GPIO, readresult);

                // Write updated GPIO state
                tle9012_WrReg(TLE9012_NTWK_CONFIG, TLE9012_BROADCAST_DEVICE, TLE9012_REG_GPIO, tle9012Info.registers[i].GPIO_Reg.U16, &errormsg);


				//Highest Cell Voltage
				tle9012Info.registers[i].SCVM_HIGH_reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i+1, TLE9012_REG_SCVM_HIGH, readresult);
				cellInfo.highestCell[i] = (float)(tle9012Info.registers[i].SCVM_HIGH_reg.B.RESULT)*5000/2048;

				//Lowest Cell Voltage
				tle9012Info.registers[i].SCVM_LOW_reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i+1, TLE9012_REG_SCVM_LOW, readresult);
				cellInfo.lowestCell[i] = (float)(tle9012Info.registers[i].SCVM_LOW_reg.B.RESULT )*5000/2048;

				//Internal temperature
				tle9012Info.registers[i].INT_TEMP_Reg.U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i+1, TLE9012_REG_INT_TEMP, readresult);
				cellInfo.intTemp[i] = 5473 - (uint16_t)((uint32_t)(tle9012Info.registers[i].INT_TEMP_Reg.B.RESULT* 6624)/1000);

				//External temperatures
				for (uint8_t therm = 0; therm < TLE9012_NUMBER_EXT_THERM; therm++)
				{
					tle9012Info.registers[i].EXT_TEMP_Reg[therm].U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i+1, TLE9012_REG_EXT_TEMP_0+therm, readresult);
					if (TEMP_IS_VALID == tle9012Info.registers[i].EXT_TEMP_Reg[therm].B.VALID)
					{
	//					cellInfo.extTemp[i][therm] = (tle9012Info.registers[i].EXT_TEMP_Reg[therm].B.RESULT) * pow(4,tle9012Info.registers[i].EXT_TEMP_Reg[therm].B.INTC) * TLE9012_EXT_OT_CONV;
						cellInfo.extTemp[i][therm] = (uint16_t)((tle9012Info.registers[i].EXT_TEMP_Reg[therm].B.RESULT) * pow(4,tle9012Info.registers[i].EXT_TEMP_Reg[therm].B.INTC)*2)/(1024*.000320)-100;
					}
				}
				//Cell Voltages
				for (uint8_t cell=0; cell<TLE9012_NUMBER_OF_CELLS; cell++)
				{
					tle9012Info.registers[i].CVM_Reg[cell].U16 = tle9012_ReadReg(TLE9012_NTWK_CONFIG, i+1, TLE9012_REG_CVM_0+cell, readresult);
					cellInfo.cellV[i][cell] = tle9012Info.registers[i].CVM_Reg[cell].B.RESULT *5000/ 65536;
					cellInfo.soc[i][cell] = bmsControl_calculateSOC(cellInfo.cellV[i][cell]);
				}
			}
			cellInfo.gettingMeasurement = 0;
		}
	}
}


