/**
 ******************************************************************************
 *
 * @author 	RL
 * @date   	Jan2021
 * @brief	Function: bmsControl_Timer100ms()\n
 * 			This routine is called every 100 milliseconds from core0_main thread
 * 			All functions that need to occur every 100ms will be placed here
 *

 * @retval	None.
 *****************************************************************************/
void bmsControl_Timer100ms(void)
{
	__private0 __far static uint8_t readTimer = 0;

	if (TRUE == bmsControl.flowControl.tle9012_Control)
	{
		if (tle9012Info.isInitialized) // 100ms timer
		{
			bmsControl_keepAliveTLE9012();

			if (readTimer == 7)
			{
				bmsControl_getCellMetrics();
			}
		}
	}

	if (readTimer++ >= 10)
	{
		readTimer = 0;
	}

	if (bmsControl.timerPrecharge++ >10)
	{
		bmsControl.timerPrecharge = 10;
	}

	bmsControl_getBatteryMetrics();

}

