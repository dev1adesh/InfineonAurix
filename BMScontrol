/**
 ******************************************************************************
 *
 * @author 	RL
 * @date   	Jan2021
 * @brief	Function: bmsControl_Timer1Sec()\n
 * 			This routine is called every second from core0_main thread
 * 			All functions that need to occur every sec will be placed here
 *
 * @retval	None.
 *****************************************************************************/
void bmsControl_Timer1Sec(void)
{
	if (TRUE == bmsControl.flowControl.tle9012_Control)
	{
		if (true == tle9012Info.startCommand )
		{
			tle9012Info.TimerStartup++;
		}
		else
		{
			tle9012Info.TimerStartup = 0;
		}

		if (tle9012Info.TimerStartup == TLE9012_ENUMERATE_DELAY  )
		{
			if (FALSE == tle9012Info.isInitialized)
			{
				tle9012Info.isInitialized = bmsControl_TLE9012_Initialization();
				if (false == tle9012Info.isInitialized)
				{
					tle9012Info.TimerStartup = 0;
				}
			}
		}
		else if (tle9012Info.TimerStartup >= STARTUP_DELAY)
		{
			tle9012Info.TimerStartup = STARTUP_DELAY;

			if (false == bmsControl.flagConfig9012)
			{
				bmsControl_ConfigTLE9012();
				 bmsControl.flagConfig9012 = true;
			}
		}

		//apply VCC to the Fuel Gauge Board via VOUT_L_0
		if ((tle9012Info.TimerStartup >= FUEL_GAUGE_START_DELAY) && (tle9012Info.isInitialized == true)&&(0 != bmsControl.flowControl.fuelGauge_Control))
		{
//			FUEL_GAUGE_ENABLE; TODO: remove me once fixed
		}

		if (tle9012Info.isInitialized)
		{
			if (TRUE == ecu8Info.flag.cyclingStarted)
			{
				ecu8Control_cyclingControl();
			}
			else
			{
				bmsControl_chargeDischarge_Control();
			}

			bmsControl_CheckBalancing();
			bmsControl_Protection();

			//start checking for faults
			//if no faults for 50s then initate cycling
			if (FALSE == ecu8Info.flag.cyclingStarted && TRUE == ecu8Info.flag.startCycling)
			{
				if (ECU8_CYCLING_START_TIME <= ecu8Info.counter.startCycling )
				{
					// lets start the cycling sequence
					ecu8Info.flag.cyclingStarted = TRUE;
				}
				else if (bmsControl.protection != 0)
				{
					//fault has occurred, reset the timer
					//make sure red led is on
					ecu8Info.counter.startCycling = 0;
				}
				else
				{
					ecu8Info.counter.startCycling++;
//					IDLE_LED_ON;
				}
			}
		}
	}
}

